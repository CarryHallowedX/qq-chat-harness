{
  "name": "qq-chat-harness",
  "version": "0.2.1",
  "private": true,
  "description": "QQ 机器人对话编排层插件（M2-lite：组合包外壳 + 工作区/记忆/表情包存储）",
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "build": "node scripts/build-dist.mjs",
    "smoke": "npm run m1 && npm run m2",
    "typecheck": "tsc --noEmit",
    "m1": "node test/m1-smoke.ts",
    "m2": "node test/m2-routing-smoke.ts"
  },
  "main": "dist/plugin.js",
  "exports": {
    ".": "./dist/plugin.js",
    "./lib": "./dist/index.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "dist",
    "src",
    "scripts",
    "locale",
    "cordis.patch.yml",
    "README.md"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
